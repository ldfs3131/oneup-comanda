# ===== Happy Alpha — configuração do servidor =====
# Copie este arquivo para ".env" (o instalador faz isso sozinho).

# Porta do sistema (tablet acessa http://IP-DO-CAIXA:3010)
PORT=3010

# Banco de dados de PRODUÇÃO
DATABASE_URL=postgres://postgres:SENHA_DO_POSTGRES@localhost:5432/happy_alpha

# Pastas de backup separadas por ";" (pendrive e pasta do Google Drive, por exemplo)
BACKUP_DIRS=C:\HappyAlpha-Backups;G:\Meu Drive\HappyAlpha-Backups

# Caminho do pg_dump (vem com o PostgreSQL)
PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
