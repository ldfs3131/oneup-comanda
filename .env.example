# ===== ONE UP — configuração do servidor (online, Coolify) =====

PORT=3010

# Banco (PostgreSQL 16). Este usuário roda as migrações e as tarefas da plataforma:
# precisa ser superusuário ou ter BYPASSRLS. A aplicação troca sozinha para o papel
# restrito APP_DB_ROLE (sem BYPASSRLS), que só enxerga a empresa da requisição.
DATABASE_URL=postgres://postgres:SENHA@oneup-db:5432/oneup
APP_DB_ROLE=oneup_app
DB_POOL_SIZE=20

# Cada empresa acessa por <slug>.BASE_DOMAIN (ex.: happyalpha.restaurantes.oneup.com.br).
# DNS: registro curinga *.restaurantes.oneup.com.br apontando para o servidor (Cloudflare).
BASE_DOMAIN=restaurantes.oneup.com.br

# Instalação de uma empresa só (sem subdomínio): informe o slug dela. Deixe vazio na plataforma.
DEFAULT_EMPRESA=

# Online com HTTPS: true. Proxies na frente (Cloudflare + Coolify = 2).
COOKIE_SECURE=true
TRUST_PROXY=2

# Somente desenvolvimento e testes: aceita o cabeçalho x-empresa. NUNCA ligar em produção.
EMPRESA_HEADER=false

# Leitura dos números (Insights): serviço da ONE UP; desligado para o restaurante.
INSIGHTS_ENABLED=false

# Backup local por pasta: só em instalação própria. Online, o backup do banco é diário
# (Cloudflare R2, 30 dias), feito pela plataforma fora da aplicação.
BACKUP_DIRS=
PG_DUMP_PATH=pg_dump
