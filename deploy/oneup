# ------------------------------------------------------------------------------------------------
# Atualização: conferências depois de trocar a versão
# ------------------------------------------------------------------------------------------------
instalar_unidades() {  # copia as unidades do systemd; devolve 0 se alguma mudou
  local u mudou=1
  for u in "$APP"/deploy/*.service "$APP"/deploy/*.timer; do
    cmp -s "$u" "/etc/systemd/system/$(basename "$u")" && continue
    install -m 644 "$u" "/etc/systemd/system/$(basename "$u")"; mudou=0
  done
  return "$mudou"
}
conferir_versao() {  # versão no ar = versão baixada? compilado (dist) junto com o código-fonte?
  local esperada no_ar ok=0 parte src dist
  esperada=$(node -p "require('$APP/server/package.json').version" 2>/dev/null)
  no_ar=$(curl -fsS --max-time 10 "http://127.0.0.1:$(porta)/api/health" 2>/dev/null | grep -o '"versao":"[^"]*"' | cut -d'"' -f4)
  if [ -n "$esperada" ] && [ "$no_ar" != "$esperada" ]; then
    vermelho "Atenção: o sistema no ar diz versão ${no_ar:-?}, mas o código baixado é $esperada."
    echo "  Rode 'oneup reiniciar'. Se continuar diferente, avise o suporte (o sistema pode estar rodando um processo antigo)."
    ok=1
  fi
  # o servidor roda o compilado (server/dist e web/dist), que vai junto no GitHub: se o código-fonte mudou depois
  # do último compilado, a ONE UP esqueceu de compilar e a versão nova não está valendo de verdade
  for parte in server web; do
    src=$(git -C "$APP" log -1 --format=%ct -- "$parte/src" 2>/dev/null)
    dist=$(git -C "$APP" log -1 --format=%ct -- "$parte/dist" 2>/dev/null)
    if [[ "$src" =~ ^[0-9]+$ ]] && [[ "$dist" =~ ^[0-9]+$ ]] && [ "$src" -gt "$dist" ]; then
      vermelho "Atenção: o código de '$parte' é mais novo que o compilado ($parte/dist) nesta versão. Avise o suporte: falta compilar."
      ok=1
    fi
  done
  [ "$ok" = 0 ] && verde "Versão no ar confere: $esperada."
  return "$ok"
}

status() {
  local ult h t d ext url mail web
  web=$(envget ONEUP_WEB)
  systemctl --no-pager --lines=0 status oneup "${web:-caddy}" postgresql 2>/dev/null | grep -E '●|Active'; echo
  saude 3 && verde "Sistema respondendo." || vermelho "Sistema NÃO está respondendo."
  echo "Endereço base: $(envget BASE_DOMAIN) · servidor web: $(envget ONEUP_WEB) · porta interna: $(porta) · versão: $(node -p "require('$APP/server/package.json').version" 2>/dev/null)"
  pg_isready -q && verde "Banco de dados respondendo." || vermelho "Banco de dados NÃO responde (sudo systemctl restart postgresql)."
  ult=$(ultimo_dump)
  if [ -n "$ult" ]; then h=$(horas_desde "$(stat -c %Y "$ult")"); [ "$h" -le "$ATRASO_MAX_H" ] && echo "Última cópia local: $(basename "$ult") (há ${h} h)" || vermelho "Última cópia local há ${h} h: o backup diário NÃO está rodando."; else vermelho "Nenhuma cópia de segurança encontrada."; fi
  ext=$(externo_remoto)
  if [ -z "$ext" ]; then
    amarelo "Cópia externa NÃO configurada: se o servidor sumir, as cópias somem junto. Ligue com: oneup backup-externo configurar"
  else
    t=$(cat "$ESTADO/ultimo-envio-externo" 2>/dev/null || true)
    if [[ "$t" =~ ^[0-9]+$ ]]; then
      h=$(horas_desde "$t")
      [ "$h" -le "$ATRASO_MAX_H" ] && echo "Cópia no Google Drive ($ext): $(cat "$ESTADO/ultimo-envio-externo.nome" 2>/dev/null) em $(quando_txt "$t") (há ${h} h)" \
        || vermelho "Cópia no Google Drive: a última chegou há ${h} h ($(quando_txt "$t")). Rode: oneup backup-externo agora"
    else vermelho "Cópia no Google Drive configurada ($ext), mas nenhuma enviada ainda. Rode: oneup backup-externo agora"; fi
  fi
  url=$(envget ALERTA_URL); mail=$(envget ALERTA_EMAIL)
  if [ -n "$url$mail" ]; then echo "Avisos: $([ -n "$url" ] && { [[ "$url" == *callmebot* ]] && echo -n "WhatsApp " || echo -n "URL "; })$([ -n "$mail" ] && echo -n "e-mail $mail")"
  else amarelo "Avisos NÃO configurados (ninguém fica sabendo se algo falhar). Ligue com: oneup alertas configurar"; fi
  if auto_ligada && systemctl is-active -q oneup-autoatualizar.timer 2>/dev/null; then
    echo "Atualização automática: ligada (todo dia às 04:10). Última: $(cat "$AUTO_ULTIMA" 2>/dev/null || echo 'ainda não rodou')"
  elif auto_ligada; then amarelo "Atualização automática: o relógio está parado (rode o instalador de novo)."
  else amarelo "Atualização automática: desligada (ligar: oneup atualizacao-automatica ligar)."; fi
  systemctl is-active -q oneup-vigia.timer 2>/dev/null && echo "Vigia de hora em hora: ligado." || amarelo "Vigia de hora em hora: desligado (rode o instalador de novo)."
  if [ "$(envget ONEUP_WEB)" = nginx ] && [ -f "$CERT_LE" ]; then
    d=$(dias_para_vencer "$CERT_LE" || echo '?'); echo "Cadeado HTTPS: vence em $d dias (renova sozinho perto do fim)."
  fi
  du -sh "$BKP" 2>/dev/null | awk '{print "Pasta de cópias: "$1}'
  df -h "$BASE" 2>/dev/null | tail -1 | awk '{print "Disco: "$3" usados de "$2" ("$5")"}'
}

# HTTPS no modo Nginx: um certificado com todos os restaurantes que já têm DNS apontando para cá
certificado() {
  carregar_env
  [ "${ONEUP_WEB:-caddy}" = nginx ] || { verde "Caddy emite o certificado sozinho na primeira visita. Nada a fazer."; return 0; }
  local ip nomes=() faltam=() n slug
  ip=$(curl -4 -fsS --max-time 10 https://api.ipify.org 2>/dev/null || true)
  for slug in $(sudo -u postgres psql -d oneup -tAc "SELECT slug FROM empresas WHERE status <> 'CANCELADA' AND EXISTS (SELECT 1 FROM users u WHERE u.empresa_id = empresas.id) ORDER BY id"); do
    n="$slug.$BASE_DOMAIN"
    if [ "${ONEUP_ENSAIO:-}" = 1 ] || { [ -n "$ip" ] && dig +short A "$n" | grep -qx "$ip"; } || { [ -z "$ip" ] && [ -n "$(dig +short A "$n")" ]; }; then nomes+=("$n"); else faltam+=("$n"); fi
  done
  if [ ${#faltam[@]} -gt 0 ]; then
    vermelho "Estes endereços ainda não apontam para este servidor (${ip:-IP desconhecido}): ${faltam[*]}"
    echo "  No painel da Hostinger → Domínios → oneupsistemas.com.br → DNS, crie o registro:"
    echo "    Tipo A · Nome: *.${BASE_DOMAIN%.oneupsistemas.com.br} · Aponta para: ${ip:-<IP da VPS>} · TTL 300"
    echo "  Espere uns minutos e rode de novo: oneup certificado"
  fi
  [ ${#nomes[@]} -gt 0 ] || return 1
  if [ "${ONEUP_ENSAIO:-}" = 1 ]; then verde "Ensaio: certificado pulado para ${nomes[*]}"; return 0; fi
  local args=() email_args=(--register-unsafely-without-email)
  for n in "${nomes[@]}"; do args+=(-d "$n"); done
  [ -n "${ONEUP_EMAIL:-}" ] && email_args=(-m "$ONEUP_EMAIL")
  if certbot --nginx --non-interactive --agree-tos --redirect --expand --cert-name oneup-comanda "${email_args[@]}" "${args[@]}"; then
    verde "HTTPS ativo: ${nomes[*]} (renovação automática pelo certbot)"
    [ ${#faltam[@]} -eq 0 ]
  else
    vermelho "O Let's Encrypt recusou o certificado. Confira o DNS e rode de novo: oneup certificado"; return 1
  fi
}
plataforma() { carregar_env; cd "$APP/server" && node dist/scripts/plataforma.js "$@"; local r=$?; chown -R oneup:oneup "$BASE/uploads" 2>/dev/null; return $r; }

atualizar() {
  cd "$APP" || exit 1
  local antes ramo copia ok t
  antes=$(git rev-parse HEAD)
  echo "Versão atual: $(git log -1 --format='%h %s')"
  git fetch --quiet origin || { vermelho "Não consegui baixar do GitHub (chave de acesso?)."; exit 1; }
  ramo=$(git rev-parse --abbrev-ref HEAD)
  if [ "$(git rev-parse "origin/$ramo")" = "$antes" ]; then verde "Já está na versão mais nova."; exit 0; fi
  backup || { vermelho "Sem cópia de segurança, não atualizo."; exit 1; }
  copia=$ULTIMO_DUMP
  # o vigia não avisa "fora do ar" enquanto a atualização reinicia o sistema
  mkdir -p "$ESTADO"; touch "$ESTADO/manutencao"; trap 'rm -f "$ESTADO/manutencao"' EXIT
  voltar() {
    vermelho "$1 Voltando para a versão anterior…"
    git reset --quiet --hard "$antes"
    local ok=0 t
    for t in 1 2 3; do npm ci --omit=dev -w server --no-audit --no-fund --loglevel=error && { ok=1; break; }; sleep 5; done
    if [ "$ok" != 1 ]; then
      # sem as dependências completas, reiniciar derrubaria de vez: o processo que está rodando continua
      vermelho "Não consegui reinstalar as dependências da versão anterior (internet?). NÃO reiniciei: o sistema segue com o processo que já estava no ar."
      echo "  Quando a internet voltar, rode: oneup atualizar   (ou chame o suporte). Cópia feita agora: $copia"
      exit 1
    fi
    instalar_unidades && systemctl daemon-reload
    systemctl restart oneup
    if saude 60; then verde "Voltou para a versão anterior (dados preservados)."
    else vermelho "A versão anterior também não ligou. Restaure a cópia feita agora: oneup restaurar $copia  — e chame o suporte."; fi
    exit 1
  }
  git reset --quiet --hard "origin/$ramo" || voltar "Não consegui trocar o código."
  ok=0; for t in 1 2 3; do npm ci --omit=dev -w server --no-audit --no-fund --loglevel=error && { ok=1; break; }; sleep 5; done
  [ "$ok" = 1 ] || voltar "Não consegui instalar as dependências (internet?)."
  # troca o próprio comando por renomeação (o bash que está rodando continua lendo a versão antiga)
  install -m 755 deploy/oneup /usr/local/bin/oneup.novo && mv -f /usr/local/bin/oneup.novo /usr/local/bin/oneup
  instalar_unidades; systemctl daemon-reload
  systemctl enable -q oneup-vigia.timer 2>/dev/null && systemctl start oneup-vigia.timer 2>/dev/null
  systemctl enable -q oneup-autoatualizar.timer 2>/dev/null && systemctl start oneup-autoatualizar.timer 2>/dev/null
  systemctl restart oneup
  saude 90 || voltar "A versão nova não ligou."
  verde "Atualizado: $(git log -1 --format='%h %s')"
  echo "Cópia de antes da atualização: $copia"
  conferir_versao || true
}

# ------------------------------------------------------------------------------------------------
# Atualização automática (de madrugada, pelo oneup-autoatualizar.timer). Ligada de fábrica.
# Só atualiza se houver versão nova; adia se teve pedido nos últimos 20 min (restaurante aberto até tarde);
# avisa no WhatsApp/e-mail o resultado. Nunca roda junto com outra atualização.
# ------------------------------------------------------------------------------------------------
AUTO_DESLIGADA=$ESTADO/auto-atualizar-desligado
AUTO_ULTIMA=$ESTADO/ultima-autoatualizacao
auto_ligada() { [ ! -f "$AUTO_DESLIGADA" ]; }
auto_registrar() { mkdir -p "$ESTADO"; printf '%s · %s\n' "$(date '+%d/%m/%Y %H:%M')" "$1" > "$AUTO_ULTIMA"; }
pedidos_recentes() {  # quantos pedidos nos últimos N minutos (todas as empresas); vazio se não conseguiu ler
  sudo -u postgres psql -d oneup -tAc "SELECT count(*) FROM orders WHERE created_at > now() - interval '${1:-20} minutes'" 2>/dev/null | tr -d ' '
}
atualizar_automatico() {
  auto_ligada || { echo "Atualização automática desligada (oneup atualizacao-automatica ligar)."; return 0; }
  cd "$APP" || return 1
  local antes ramo novo depois log r n versao
  mkdir -p "$ESTADO"; exec 9>"$ESTADO/.atualizando" && flock -n 9 || { echo "Outra atualização em andamento."; return 0; }
  antes=$(git rev-parse HEAD)
  if ! git fetch --quiet origin; then
    auto_registrar "não consegui falar com o GitHub"
    avisar_uma_vez auto-github "Atualização automática: não consegui falar com o GitHub (internet ou chave de acesso). O sistema segue normal na versão atual."
    return 1
  fi
  limpar_aviso auto-github
  ramo=$(git rev-parse --abbrev-ref HEAD); novo=$(git rev-parse "origin/$ramo")
  if [ "$novo" = "$antes" ]; then auto_registrar "já estava na versão mais nova"; echo "Já está na versão mais nova."; return 0; fi
  # versão que já falhou numa noite anterior: não tenta de novo toda madrugada (espera a correção chegar)
  if [ "$novo" = "$(cat "$ESTADO/auto-falhou" 2>/dev/null)" ]; then
    auto_registrar "esperando correção (a versão ${novo:0:7} já falhou antes)"; echo "Essa versão já falhou antes; esperando a correção."; return 0
  fi
  n=$(pedidos_recentes 20)
  if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt 0 ]; then
    auto_registrar "adiada: $n pedido(s) nos últimos 20 min"
    echo "Teve pedido há pouco ($n). Fica para a próxima madrugada."
    return 0
  fi
  log="$ESTADO/autoatualizacao.log"
  # 9>&-: o sistema reiniciado (e qualquer filho) não herda a trava
  ( atualizar ) 9>&- > "$log" 2>&1; r=$?
  depois=$(git rev-parse HEAD)
  versao=$(node -p "require('$APP/server/package.json').version" 2>/dev/null)
  if [ "$r" = 0 ] && [ "$depois" = "$novo" ] && saude 10; then
    rm -f "$ESTADO/auto-falhou"
    auto_registrar "atualizado para a versão $versao"
    enviar_alerta "Sistema atualizado sozinho para a versão $versao ($(git log -1 --format='%s' | cut -c1-90)). Cópia de segurança feita antes." || true
  elif [ "$depois" = "$antes" ] && saude 10; then
    echo "$novo" > "$ESTADO/auto-falhou"
    auto_registrar "falhou e voltou para a versão anterior"
    enviar_alerta "A atualização automática falhou e o sistema VOLTOU sozinho para a versão anterior. Está no ar e nada foi perdido. Detalhes: $log" || true
  else
    echo "$novo" > "$ESTADO/auto-falhou"
    auto_registrar "terminou com problema"
    enviar_alerta "A atualização automática terminou com problema. Rode: oneup status  (detalhes em $log)" || true
  fi
  cat "$log"
  return "$r"
}

# ------------------------------------------------------------------------------------------------
# Zerar os dados de TESTE de um restaurante antes da entrega: pedidos, contas, pagamentos, caixas, fiado,
# despesas, clientes, histórico; quantidades do estoque voltam a 0 (para a contagem inicial).
# Mantém: empresa, cardápio (produtos, preços, custos, fotos, categorias, opções), configurações, formas de
# pagamento e taxas, logins/senhas/PINs/aparelhos e a base de comparação da maquininha.
# As travas do banco que impedem apagar pedidos ficam desligadas SÓ dentro desta transação (superusuário).
# ------------------------------------------------------------------------------------------------
psql_oneup() { sudo -u postgres psql -d "${ONEUP_DB:-oneup}" -v ON_ERROR_STOP=1 -qtAX "$@"; }
zerar_contagens() {  # id → "rótulo:quantidade" por linha
  psql_oneup -c "
    SELECT 'Pedidos', count(*) FROM orders WHERE empresa_id=$1 UNION ALL
    SELECT 'Contas', count(*) FROM accounts WHERE empresa_id=$1 UNION ALL
    SELECT 'Contas pendentes (fiado)', count(*) FROM accounts WHERE empresa_id=$1 AND status='PENDING' UNION ALL
    SELECT 'Pagamentos', count(*) FROM payments WHERE empresa_id=$1 UNION ALL
    SELECT 'Aberturas de caixa', count(*) FROM cash_registers WHERE empresa_id=$1 UNION ALL
    SELECT 'Despesas', count(*) FROM expenses WHERE empresa_id=$1 UNION ALL
    SELECT 'Clientes cadastrados', count(*) FROM customers WHERE empresa_id=$1 UNION ALL
    SELECT 'Movimentações de estoque', count(*) FROM stock_movements WHERE empresa_id=$1 UNION ALL
    SELECT 'Produtos com quantidade em estoque', count(*) FROM products WHERE empresa_id=$1 AND stock_qty<>0" | tr '|' ':'
}
zerar_empresa() {  # slug
  local slug=$1 id nome conf aberto
  [[ "$slug" =~ ^[a-z0-9-]+$ ]] || { echo "Uso: oneup zerar <endereco-do-restaurante>   (ex.: oneup zerar happy-alpha)"; return 1; }
  id=$(psql_oneup -c "SELECT id FROM empresas WHERE slug='$slug'")
  [[ "$id" =~ ^[0-9]+$ ]] || { vermelho "Restaurante \"$slug\" não encontrado. Veja os endereços com: oneup plataforma empresas"; return 1; }
  nome=$(psql_oneup -c "SELECT nome FROM empresas WHERE id=$id")
  echo; amarelo "ZERAR OS DADOS DE TESTE — $nome ($slug)"
  echo "Vai APAGAR:"; zerar_contagens "$id" | sed 's/^/   · /; s/:/: /'
  echo "Vai MANTER: cardápio (produtos, preços, custos, fotos e categorias), configurações, formas de pagamento e taxas,"
  echo "            logins, senhas e PINs, e a base de comparação da maquininha. As quantidades do estoque voltam a 0."
  aberto=$(psql_oneup -c "SELECT count(*) FROM cash_registers WHERE empresa_id=$id AND status='OPEN'")
  [ "${aberto:-0}" = 0 ] || amarelo "Há um caixa aberto: ele também será apagado (use só antes da entrega, nunca com o restaurante funcionando)."
  echo
  if [ -n "${ONEUP_CONFIRMAR:-}" ]; then conf=$ONEUP_CONFIRMAR
  else read -r -p "Para confirmar, digite o endereço do restaurante ($slug): " conf; fi
  [ "$conf" = "$slug" ] || { amarelo "Não confirmado. Nada foi apagado."; return 1; }
  backup || { vermelho "Sem cópia de segurança, não apago nada."; return 1; }
  local copia=$ULTIMO_DUMP
  if ! psql_oneup <<SQL
BEGIN;
SET LOCAL session_replication_role = replica;
DELETE FROM crm_comprovantes WHERE empresa_id=$id;
DELETE FROM crm_eventos WHERE empresa_id=$id;
DELETE FROM crm_cobrancas WHERE empresa_id=$id;
DELETE FROM order_time_corrections WHERE empresa_id=$id;
DELETE FROM cancellations WHERE empresa_id=$id;
DELETE FROM stock_movements WHERE empresa_id=$id;
DELETE FROM discounts WHERE empresa_id=$id;
DELETE FROM payments WHERE empresa_id=$id;
DELETE FROM order_items WHERE empresa_id=$id;
DELETE FROM orders WHERE empresa_id=$id;
DELETE FROM accounts WHERE empresa_id=$id;
DELETE FROM expenses WHERE empresa_id=$id;
DELETE FROM cash_movements WHERE empresa_id=$id;
DELETE FROM cash_registers WHERE empresa_id=$id;
DELETE FROM customers WHERE empresa_id=$id;
DELETE FROM status_events WHERE empresa_id=$id;
DELETE FROM idempotency_keys WHERE empresa_id=$id;
DELETE FROM insight_log WHERE empresa_id=$id;
DELETE FROM analise_relatorios WHERE empresa_id=$id;
DELETE FROM pendencias_resolvidas WHERE empresa_id=$id;
DELETE FROM excluded_days WHERE empresa_id=$id;
DELETE FROM audit_logs WHERE empresa_id=$id;
DELETE FROM counters WHERE empresa_id=$id AND name IN ('account','order');
UPDATE products SET stock_qty = 0 WHERE empresa_id=$id;
UPDATE restaurant_settings SET is_open = false WHERE empresa_id=$id;
UPDATE delivery_settings SET is_open = false WHERE empresa_id=$id;
INSERT INTO audit_logs (empresa_id, action, entity_type, message, user_role)
  VALUES ($id, 'sistema.zerado', 'empresa', 'Dados de teste apagados para a entrega (pedidos, caixas, clientes e estoque zerados) pela ONE UP em ' || to_char(now() AT TIME ZONE 'America/Sao_Paulo', 'DD/MM/YYYY HH24:MI') || '.', 'ONEUP');
COMMIT;
SQL
  then vermelho "A limpeza falhou e NADA foi apagado (tudo ou nada). Mande esta tela para o suporte."; return 1; fi
  systemctl restart oneup; saude 60 || amarelo "O sistema demorou a voltar. Rode: oneup status"
  echo; verde "Pronto: $nome está zerado para a entrega."
  echo "Agora:"; zerar_contagens "$id" | sed 's/^/   · /; s/:/: /'
  echo "Produtos no cardápio (mantidos): $(psql_oneup -c "SELECT count(*) FROM products WHERE empresa_id=$id")"
  echo "O primeiro pedido real será o nº 1. Próximo passo: o Dono faz a contagem inicial em Estoque."
  echo "Cópia de antes da limpeza (se precisar voltar): $copia"
}

# carregado pelo instalador ou pelos testes: só as funções
# shellcheck disable=SC2317
if [ "${ONEUP_SO_FUNCOES:-}" = 1 ]; then return 0 2>/dev/null || exit 0; fi

[ "$(id -u)" = 0 ] || { vermelho "Use como root."; exit 1; }
case "${1:-ajuda}" in
  status) status ;;
  logs) journalctl -u oneup -n "${2:-100}" --no-pager ;;
  reiniciar) systemctl restart oneup && saude && verde "Reiniciado." || vermelho "Não voltou. Veja: oneup logs" ;;
  backup) backup ;;
  backup-diario) backup_diario ;;
  backup-externo)
    case "${2:-}" in
      configurar) configurar_externo ;;
      agora) backup && enviar_externo "$ULTIMO_DUMP" ;;
      listar) listar_externo ;;
      usar) [ -n "${3:-}" ] || { echo "Uso: oneup backup-externo usar <remoto:pasta>  (remoto já criado com: RCLONE_CONFIG=$RCLONE_CONF rclone config)"; exit 1; }
            testar_e_usar_remoto "$3" ;;
      desligar) env_definir BACKUP_EXTERNO "" && amarelo "Cópia externa desligada (as cópias que já estão no Drive continuam lá)." ;;
      *) echo "Uso: oneup backup-externo configurar | agora | listar | desligar"; exit 1 ;;
    esac ;;
  restaurar-externo)
    if [ -z "${2:-}" ]; then listar_externo; exit 1; fi
    restaurar_externo "$2" ;;
  alertas)
    case "${2:-}" in
      configurar) configurar_alertas ;;
      *) echo "Uso: oneup alertas configurar   ·   oneup alerta teste"; exit 1 ;;
    esac ;;
  alerta)
    case "${2:-}" in
      teste) if enviar_alerta "Teste: os avisos do ONE UP Comanda estão funcionando."; then verde "Aviso de teste enviado."
             else r=$?; [ "$r" = 2 ] && amarelo "Nenhum destino de aviso configurado. Rode: oneup alertas configurar" || vermelho "O envio falhou (veja $LOG_ALERTAS)."; exit 1; fi ;;
      *) echo "Uso: oneup alerta teste"; exit 1 ;;
    esac ;;
  alerta-falha) alerta_falha "${2:-desconhecido}" ;;
  vigia) vigia ;;
  certificado) certificado ;;
  acessos) cat /root/oneup-acessos.txt 2>/dev/null || echo "Nenhum acesso registrado." ;;
  atualizar) atualizar ;;
  zerar) zerar_empresa "${2:-}" ;;
  atualizar-automatico) atualizar_automatico ;;
  atualizacao-automatica)
    case "${2:-status}" in
      ligar) rm -f "$AUTO_DESLIGADA"; systemctl enable -q --now oneup-autoatualizar.timer 2>/dev/null
             verde "Atualização automática ligada: todo dia às 04:10 o servidor confere o GitHub e atualiza sozinho (avisa no WhatsApp)." ;;
      desligar) mkdir -p "$ESTADO"; touch "$AUTO_DESLIGADA"
                amarelo "Atualização automática desligada. Para atualizar: oneup atualizar   ·   religar: oneup atualizacao-automatica ligar" ;;
      agora) atualizar_automatico ;;
      status) if ! auto_ligada; then echo "Desligada."
              elif systemctl is-enabled -q oneup-autoatualizar.timer 2>/dev/null && systemctl is-active -q oneup-autoatualizar.timer 2>/dev/null; then echo "Ligada (todo dia às 04:10)."
              else amarelo "O relógio está PARADO. Ligue com: oneup atualizacao-automatica ligar"; fi
              echo "Última: $(cat "$AUTO_ULTIMA" 2>/dev/null || echo 'ainda não rodou')" ;;
      *) echo "Uso: oneup atualizacao-automatica ligar | desligar | status"; exit 1 ;;
    esac ;;
  versao) conferir_versao ;;
  nova-empresa)
    slug=${2:-}; nome=${3:-}
    [ -n "$slug" ] && [ -n "$nome" ] || { echo 'Uso: oneup nova-empresa <endereco> "Nome do restaurante" [login-do-dono]'; exit 1; }
    dono=${4:-dono}
    [[ "$slug" =~ ^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$ ]] || { echo "Endereço inválido: use letras minúsculas, números e hífen."; exit 1; }
    pd=$(senha 10); pc=$(pin 6); pk=$(pin 6)
    carregar_env; cd "$APP/server" || exit 1
    node dist/scripts/setup.js --empresa="$slug" --nome="$nome" --admin-name="$nome" --admin-user="$dono" --admin-pass="$pd" --caixa-pass="$pc" --cozinha-pass="$pk" --cardapio=vazio || exit 1
    umask 077
    printf '==================== %s — criado em %s ====================\nEndereço:   https://%s.%s\nDono:       login %s   senha %s\nCaixa:      login caixa   senha %s\nCozinha:    login cozinha senha %s\n\n' \
      "$nome" "$(date '+%d/%m/%Y %H:%M')" "$slug" "$BASE_DOMAIN" "$dono" "$pd" "$pc" "$pk" | tee -a /root/oneup-acessos.txt
    echo "Para entrar com o seu acesso de suporte: oneup plataforma oneup-usuario --empresa=$slug --login=lucas --nome=\"Lucas (ONE UP)\" --senha=<senha>"
    certificado || true
    ;;
  senha)
    slug=${2:-}; login=${3:-}
    [ -n "$slug" ] && [ -n "$login" ] || { echo 'Uso: oneup senha <empresa> <login>   (gera uma senha nova e derruba os aparelhos conectados)'; exit 1; }
    nova=$(senha 10)
    plataforma senha --empresa="$slug" --login="$login" --senha="$nova" && verde "Nova senha de $login em $slug: $nova"
    ;;
  restaurar)
    arq=${2:-}
    # shellcheck disable=SC2012
    [ -f "$arq" ] || { echo "Uso: oneup restaurar /opt/oneup/backups/oneup-AAAA-MM-DD_HHMMSS.dump"; ls -1t "$BKP"/oneup-*.dump 2>/dev/null | head -5; exit 1; }
    restaurar_banco "$arq" ;;
  plataforma) shift; plataforma "$@" ;;
  ajuda|*)
    cat <<'TXT'
ONE UP Comanda — comandos do servidor
  oneup status                 situação do sistema, endereço, cópias (local e Google Drive), avisos e disco
  oneup logs [linhas]          últimos registros do sistema
  oneup reiniciar              reinicia o sistema
  oneup atualizar              baixa a versão nova do GitHub (faz cópia antes e volta sozinho se falhar)
  oneup atualizacao-automatica ligar|desligar|status
                               atualização sozinha de madrugada (04:10), avisa no WhatsApp; ligada de fábrica
  oneup versao                 confere se a versão no ar é a baixada
  oneup backup                 cópia de segurança agora, no servidor (automática todo dia às 03:30, guarda 14 dias)
  oneup restaurar <arquivo>    volta o banco para uma cópia do servidor (faz cópia do estado atual antes)

  Cópia fora do servidor (Google Drive da ONE UP, cifrada; 30 diárias + 12 mensais):
  oneup backup-externo configurar   conecta o Google Drive (passo a passo)
  oneup backup-externo agora        faz uma cópia e envia agora
  oneup backup-externo listar       mostra as cópias que estão no Drive
  oneup restaurar-externo <nome>    baixa do Drive, abre e volta o banco (ex.: oneup-2026-10-04_033012.tar.gpg)

  Avisos no WhatsApp/Telegram/e-mail (backup falhou, disco cheio, cadeado vencendo, sistema fora do ar):
  oneup alertas configurar     escolhe para onde vão os avisos (passo a passo)
  oneup alerta teste           manda um aviso de teste

  oneup acessos                mostra endereços e senhas criados na instalação
  oneup zerar <endereco>       apaga os dados de TESTE antes da entrega (pedidos, caixas, clientes; estoque a 0)
                               mantém cardápio, configurações e senhas; faz cópia antes e pede confirmação
  oneup certificado            HTTPS dos restaurantes (modo Nginx; confere o DNS antes)
  oneup nova-empresa <endereco> "Nome" [login]   cria outro restaurante (ex.: oneup nova-empresa bom-sabor "Bom Sabor")
  oneup senha <empresa> <login>                  gera senha nova para alguém que esqueceu
  oneup plataforma <comando>   ferramenta da ONE UP (empresas, catalogo, travar, definir, provisionar, oneup-usuario)
TXT
    ;;
