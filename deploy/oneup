#!/usr/bin/env bash
# ONE UP Comanda — comandos do servidor. Digite: oneup ajuda
set -uo pipefail
APP=/opt/oneup/app
BASE=/opt/oneup
ENVF=$BASE/.env
BKP=$BASE/backups
GUARDAR_DIAS=${GUARDAR_DIAS:-14}
export PATH="$BASE/node/bin:$PATH"   # Node próprio do ONE UP Comanda (o dos outros sistemas não muda)

verde() { printf '\033[1;32m%s\033[0m\n' "$*"; }
vermelho() { printf '\033[1;31m%s\033[0m\n' "$*"; }
[ "$(id -u)" = 0 ] || { vermelho "Use como root."; exit 1; }
senha() { local s; s=$(head -c 600 /dev/urandom | LC_ALL=C tr -dc 'abcdefghjkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789'); echo "${s:0:${1:-10}}"; }
pin() { local s; s=$(head -c 600 /dev/urandom | LC_ALL=C tr -dc '0-9'); echo "${s:0:${1:-6}}"; }
carregar_env() { set -a; . "$ENVF"; set +a; }
porta() { grep '^PORT=' "$ENVF" 2>/dev/null | cut -d= -f2 || echo 3010; }
saude() { local p; p=$(porta); for i in $(seq 1 "${1:-60}"); do curl -fsS "http://127.0.0.1:${p:-3010}/api/health" >/dev/null 2>&1 && return 0; sleep 1; done; return 1; }

# HTTPS no modo Nginx: um certificado com todos os restaurantes que já têm DNS apontando para cá
certificado() {
  carregar_env
  [ "${ONEUP_WEB:-caddy}" = nginx ] || { verde "Caddy emite o certificado sozinho na primeira visita. Nada a fazer."; return 0; }
  local ip nomes=() faltam=() n
  ip=$(curl -4 -fsS --max-time 10 https://api.ipify.org 2>/dev/null || true)
  for slug in $(sudo -u postgres psql -d oneup -tAc "SELECT slug FROM empresas WHERE status <> 'CANCELADA' AND EXISTS (SELECT 1 FROM users u WHERE u.empresa_id = empresas.id) ORDER BY id"); do
    n="$slug.$BASE_DOMAIN"
    if [ "${ONEUP_ENSAIO:-}" = 1 ] || { [ -n "$ip" ] && dig +short A "$n" | grep -qx "$ip"; } || { [ -z "$ip" ] && [ -n "$(dig +short A "$n")" ]; }; then nomes+=("$n"); else faltam+=("$n"); fi
  done
  if [ ${#faltam[@]} -gt 0 ]; then
    vermelho "Estes endereços ainda não apontam para este servidor (${ip:-IP desconhecido}): ${faltam[*]}"
    echo "  No painel da Hostinger → Domínios → oneupsistemas.com.br → DNS, crie o registro:"
    echo "    Tipo A · Nome: *.${BASE_DOMAIN%.oneupsistemas.com.br} · Aponta para: ${ip:-<IP da VPS>} · TTL 300"
    echo "  Espere uns minutos e rode de novo: oneup certificado"
  fi
  [ ${#nomes[@]} -gt 0 ] || return 1
  if [ "${ONEUP_ENSAIO:-}" = 1 ]; then verde "Ensaio: certificado pulado para ${nomes[*]}"; return 0; fi
  local args=(); for n in "${nomes[@]}"; do args+=(-d "$n"); done
  if certbot --nginx --non-interactive --agree-tos --redirect --expand --cert-name oneup-comanda \
       $([ -n "${ONEUP_EMAIL:-}" ] && echo "-m $ONEUP_EMAIL" || echo "--register-unsafely-without-email") "${args[@]}"; then
    verde "HTTPS ativo: ${nomes[*]} (renovação automática pelo certbot)"
    [ ${#faltam[@]} -eq 0 ]
  else
    vermelho "O Let's Encrypt recusou o certificado. Confira o DNS e rode de novo: oneup certificado"; return 1
  fi
}
plataforma() { carregar_env; cd "$APP/server" && node dist/scripts/plataforma.js "$@"; local r=$?; chown -R oneup:oneup "$BASE/uploads" 2>/dev/null; return $r; }

backup() {
  mkdir -p "$BKP"; chmod 750 "$BKP"
  local quando arq
  quando=$(date +%Y-%m-%d_%H%M%S)
  arq="$BKP/oneup-$quando.dump"
  # o arquivo é criado pelo root já fechado (600): ninguém mais no servidor lê nem a cópia parcial
  if ( umask 077; sudo -u postgres pg_dump -Fc -d oneup > "$arq.parcial" ) && mv "$arq.parcial" "$arq"; then
    ( umask 077; tar -czf "$BKP/imagens-$quando.tar.gz" -C "$BASE" uploads 2>/dev/null ) || true
    find "$BKP" -name 'oneup-*.dump' -mtime +"$GUARDAR_DIAS" -delete
    find "$BKP" -name 'imagens-*.tar.gz' -mtime +"$GUARDAR_DIAS" -delete
    verde "Cópia salva: $arq ($(du -h "$arq" | cut -f1)). Guardando os últimos $GUARDAR_DIAS dias."
  else
    rm -f "$arq.parcial"; vermelho "Falhou a cópia do banco."; return 1
  fi
}

case "${1:-ajuda}" in
  status)
    carregar_env; systemctl --no-pager --lines=0 status oneup "${ONEUP_WEB:-caddy}" postgresql | grep -E '●|Active' ; echo
    saude 3 && verde "Sistema respondendo." || vermelho "Sistema NÃO está respondendo."
    carregar_env; echo "Endereço base: $BASE_DOMAIN · servidor web: ${ONEUP_WEB:-caddy} · porta interna: $PORT · versão: $(node -p "require('$APP/server/package.json').version")"
    pg_isready -q && verde "Banco de dados respondendo." || vermelho "Banco de dados NÃO responde (sudo systemctl restart postgresql)."
    ult=$(ls -1t $BKP/oneup-*.dump 2>/dev/null | head -1)
    if [ -n "$ult" ]; then h=$(( ( $(date +%s) - $(stat -c %Y "$ult") ) / 3600 )); [ "$h" -le 26 ] && echo "Última cópia: $(basename "$ult") (há ${h} h)" || vermelho "Última cópia há ${h} h: o backup diário NÃO está rodando."; else vermelho "Nenhuma cópia de segurança encontrada."; fi
    du -sh "$BKP" 2>/dev/null | awk '{print "Pasta de cópias: "$1}'
    df -h / | tail -1 | awk '{print "Disco: "$3" usados de "$2" ("$5")"}'
    ;;
  logs) journalctl -u oneup -n "${2:-100}" --no-pager ;;
  reiniciar) systemctl restart oneup && saude && verde "Reiniciado." || vermelho "Não voltou. Veja: oneup logs" ;;
  backup) backup ;;
  certificado) certificado ;;
  acessos) cat /root/oneup-acessos.txt 2>/dev/null || echo "Nenhum acesso registrado." ;;
  atualizar)
    cd "$APP" || exit 1
    antes=$(git rev-parse HEAD)
    echo "Versão atual: $(git log -1 --format='%h %s')"
    git fetch --quiet origin || { vermelho "Não consegui baixar do GitHub (chave de acesso?)."; exit 1; }
    ramo=$(git rev-parse --abbrev-ref HEAD)
    if [ "$(git rev-parse "origin/$ramo")" = "$antes" ]; then verde "Já está na versão mais nova."; exit 0; fi
    backup || { vermelho "Sem cópia de segurança, não atualizo."; exit 1; }
    copia=$(ls -1t "$BKP"/oneup-*.dump | head -1)
    voltar() {
      vermelho "$1 Voltando para a versão anterior…"
      git reset --quiet --hard "$antes"
      for t in 1 2 3; do npm ci --omit=dev -w server --no-audit --no-fund --loglevel=error && break; sleep 5; done
      systemctl restart oneup
      if saude 60; then verde "Voltou para a versão anterior (dados preservados)."
      else vermelho "A versão anterior também não ligou. Restaure a cópia feita agora: oneup restaurar $copia  — e chame o suporte."; fi
      exit 1
    }
    git reset --quiet --hard "origin/$ramo" || voltar "Não consegui trocar o código."
    ok=0; for t in 1 2 3; do npm ci --omit=dev -w server --no-audit --no-fund --loglevel=error && { ok=1; break; }; sleep 5; done
    [ "$ok" = 1 ] || voltar "Não consegui instalar as dependências (internet?)."
    # troca o próprio comando por renomeação (o bash que está rodando continua lendo a versão antiga)
    install -m 755 deploy/oneup /usr/local/bin/oneup.novo && mv -f /usr/local/bin/oneup.novo /usr/local/bin/oneup
    for u in oneup.service oneup-backup.service oneup-backup.timer; do install -m 644 "deploy/$u" "/etc/systemd/system/$u"; done
    systemctl daemon-reload
    systemctl restart oneup
    saude 90 || voltar "A versão nova não ligou."
    verde "Atualizado: $(git log -1 --format='%h %s')"
    echo "Cópia de antes da atualização: $copia"
    ;;
  nova-empresa)
    slug=${2:-}; nome=${3:-}
    [ -n "$slug" ] && [ -n "$nome" ] || { echo 'Uso: oneup nova-empresa <endereco> "Nome do restaurante" [login-do-dono]'; exit 1; }
    dono=${4:-dono}
    [[ "$slug" =~ ^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$ ]] || { echo "Endereço inválido: use letras minúsculas, números e hífen."; exit 1; }
    pd=$(senha 10); pc=$(pin 6); pk=$(pin 6)
    carregar_env; cd "$APP/server"
    node dist/scripts/setup.js --empresa="$slug" --nome="$nome" --admin-name="$nome" --admin-user="$dono" --admin-pass="$pd" --caixa-pass="$pc" --cozinha-pass="$pk" --cardapio=vazio || exit 1
    umask 077
    printf '==================== %s — criado em %s ====================\nEndereço:   https://%s.%s\nDono:       login %s   senha %s\nCaixa:      login caixa   senha %s\nCozinha:    login cozinha senha %s\n\n' \
      "$nome" "$(date '+%d/%m/%Y %H:%M')" "$slug" "$BASE_DOMAIN" "$dono" "$pd" "$pc" "$pk" | tee -a /root/oneup-acessos.txt
    echo "Para entrar com o seu acesso de suporte: oneup plataforma oneup-usuario --empresa=$slug --login=lucas --nome=\"Lucas (ONE UP)\" --senha=<senha>"
    certificado || true
    ;;
  senha)
    slug=${2:-}; login=${3:-}
    [ -n "$slug" ] && [ -n "$login" ] || { echo 'Uso: oneup senha <empresa> <login>   (gera uma senha nova e derruba os aparelhos conectados)'; exit 1; }
    nova=$(senha 10)
    plataforma senha --empresa="$slug" --login="$login" --senha="$nova" && verde "Nova senha de $login em $slug: $nova"
    ;;
  restaurar)
    arq=${2:-}
    [ -f "$arq" ] || { echo "Uso: oneup restaurar /opt/oneup/backups/oneup-AAAA-MM-DD_HHMM.dump"; ls -1t "$BKP"/oneup-*.dump 2>/dev/null | head -5; exit 1; }
    vermelho "ATENÇÃO: o banco inteiro (todos os restaurantes) volta para o momento desta cópia: $arq"
    read -r -p "Para continuar digite RESTAURAR: " ok; [ "$ok" = RESTAURAR ] || { echo "Cancelado."; exit 1; }
    backup || { vermelho "Não consegui fazer a cópia do estado atual antes; cancelado."; exit 1; }
    systemctl stop oneup
    ( umask 077; cp "$arq" /tmp/oneup-restaurar.dump ) && chown postgres /tmp/oneup-restaurar.dump
    if sudo -u postgres pg_restore --clean --if-exists --no-owner --role=oneup_dono --single-transaction --exit-on-error -d oneup /tmp/oneup-restaurar.dump; then r=0; else r=$?; fi
    rm -f /tmp/oneup-restaurar.dump
    systemctl start oneup
    if [ "$r" != 0 ]; then
      vermelho "A restauração FALHOU (nada foi mudado no banco: tudo ou nada). O sistema voltou com os dados de antes."
      saude 90 || vermelho "E o sistema não respondeu: oneup logs"
      exit 1
    fi
    saude 90 && verde "Restaurado e no ar." || { vermelho "Restaurado, mas o sistema não voltou: oneup logs"; exit 1; }
    ;;
  plataforma) shift; plataforma "$@" ;;
  ajuda|*)
    cat <<'TXT'
ONE UP Comanda — comandos do servidor
  oneup status                 situação do sistema, endereço, última cópia e disco
  oneup logs [linhas]          últimos registros do sistema
  oneup reiniciar              reinicia o sistema
  oneup atualizar              baixa a versão nova do GitHub (faz cópia antes e volta sozinho se falhar)
  oneup backup                 cópia de segurança agora (automática todo dia às 03:30, guarda 14 dias)
  oneup restaurar <arquivo>    volta o banco para uma cópia (faz cópia do estado atual antes)
  oneup acessos                mostra endereços e senhas criados na instalação
  oneup certificado            HTTPS dos restaurantes (modo Nginx; confere o DNS antes)
  oneup nova-empresa <endereco> "Nome" [login]   cria outro restaurante (ex.: oneup nova-empresa bom-sabor "Bom Sabor")
  oneup senha <empresa> <login>                  gera senha nova para alguém que esqueceu
  oneup plataforma <comando>   ferramenta da ONE UP (empresas, catalogo, travar, definir, provisionar, oneup-usuario)
TXT
    ;;
esac
