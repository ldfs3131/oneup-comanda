[Unit]
Description=ONE UP Comanda (sistema de gestão para restaurantes)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=oneup
Group=oneup
WorkingDirectory=/opt/oneup/app
Environment=ENV_FILE=/opt/oneup/.env
EnvironmentFile=/opt/oneup/.env
ExecStart=/opt/oneup/node/bin/node server/dist/index.js
Restart=always
RestartSec=3
# desligamento rápido (o processo fecha os tablets e sai em segundos; nunca 90 s fora do ar)
TimeoutStopSec=15
KillMode=mixed
# segurança: o processo só escreve na pasta de imagens enviadas
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/oneup/uploads
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
